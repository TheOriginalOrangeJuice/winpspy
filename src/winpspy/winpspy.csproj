<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>winpspy</AssemblyName>
    <RootNamespace>Winpspy</RootNamespace>
    <Version>2.0.1</Version>
    <Authors>TheOriginalOrangeJuice</Authors>
    <Description>Live Windows activity monitor</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Winpspy.Core/Winpspy.Core.csproj" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.8" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.12" />
  </ItemGroup>
</Project>
